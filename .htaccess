# Fallback for shared hosting where the domain's document root cannot be set
# to public/ (e.g. the app is uploaded straight into public_html).
# Sends every request into public/ so .env, vendor/, storage/ etc. are never served.
# Not used when the document root already points at public/ (recommended).
<IfModule mod_rewrite.c>
    RewriteEngine On

    # www.lalogix.com → https://lalogix.com, same path and query. Done here, before the
    # request is rewritten into public/, so the original path is redirected (not /public/...).
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # (Old /public/... URLs are redirected to the clean URL by public/.htaccess.)

    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
