<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # (www → bare domain is handled in the root .htaccess and by App\Http\Middleware\CanonicalHost.
    # It must not be done here: when the site runs through the root .htaccess, %{REQUEST_URI}
    # in this file already starts with /public/ and visitors would be sent to /public/...)

    # Someone opened a /public/... URL (e.g. a cached redirect from an older version of this
    # file): send them to the same page without /public. THE_REQUEST is the browser's original
    # request line, so the root .htaccess's internal rewrite into public/ never matches.
    RewriteCond %{THE_REQUEST} ^[A-Z]+\s(\S*?)/public(?:/([^\s?]*))?(?:\?\S*)?\s
    RewriteRule ^ %1/%2 [L,R=301]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder (/about/ → /about, query kept).
    # Uses THE_REQUEST (the browser's original path) instead of REQUEST_URI, which already
    # contains /public/ when requests come through the root .htaccess.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{THE_REQUEST} ^[A-Z]+\s(/[^\s?]*?)/+(?:\?\S*)?\s
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Compression (if the host has mod_deflate).
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

# Browser caching. Vite assets have content hashes in their names, so they never change.
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(webp|png|jpe?g|svg|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>
